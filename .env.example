# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Groq Cloud API Key from console.groq.com
GROQ_API_KEY=

# Required: Qdrant Vector Database (Local or Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional: Access Control (comma-separated Telegram numeric IDs)
TELEGRAM_ALLOWED_CHAT_IDS=
ADMIN_USER_IDS=

# Optional: Retrieval and answer controls
RETRIEVAL_LIMIT=6
RETRIEVAL_SCORE_THRESHOLD=0.45
DAILY_QUESTION_LIMIT=10
CACHE_TTL_SECONDS=86400
LOG_LEVEL=INFO
