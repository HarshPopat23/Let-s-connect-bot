# Required. Create the token with Telegram BotFather.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated Telegram numeric IDs. Empty means all chats are allowed.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_USER_IDS=

# Cloud & Local LLM Services (Set GROQ_API_KEY for 100% free cloud inference)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant Vector Database (Local or Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Models and Embeddings
EMBEDDING_PROVIDER=auto
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=nomic-embed-text
MODEL_EASY=openai/gpt-oss-20b
MODEL_STANDARD=openai/gpt-oss-120b
MODEL_COMPLEX=openai/gpt-oss-120b

# Retrieval and answer controls.
QDRANT_COLLECTION=ollm_knowledge
RETRIEVAL_LIMIT=6
RETRIEVAL_SCORE_THRESHOLD=0.45
MAX_CONTEXT_CHARACTERS=14000
ANSWER_TEMPERATURE=0.15
OLLAMA_TIMEOUT_SECONDS=180

# Cost and abuse controls.
DAILY_QUESTION_LIMIT=10
CACHE_TTL_SECONDS=86400
MAX_QUESTION_CHARACTERS=1200

# Local paths
KNOWLEDGE_DIRECTORY=knowledge
STATE_DATABASE=data/ollm.sqlite3
REINDEX_ON_START=false
LOG_LEVEL=INFO
