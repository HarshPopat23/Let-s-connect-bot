# Required: Telegram Bot Token from @BotFather (or Discord Bot Token)
TELEGRAM_BOT_TOKEN=

# Optional: Discord Bot Token from discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Optional: your Discord server (guild) ID, for instant slash-command sync during testing.
# Leave empty to sync globally instead (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# Required: Groq Cloud API Key from console.groq.com
GROQ_API_KEY=

# Required: Qdrant Vector Database (Local or Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding Provider & Models
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=nomic-embed-text

# Paths and Indexing
KNOWLEDGE_DIRECTORY=knowledge
STATE_DATABASE=data/ollm.sqlite3
REINDEX_ON_START=false
LOG_LEVEL=INFO

# Optional: Access Control (comma-separated Telegram numeric IDs)
TELEGRAM_ALLOWED_CHAT_IDS=
ADMIN_USER_IDS=

# Optional: Retrieval and answer controls
RETRIEVAL_LIMIT=6
RETRIEVAL_SCORE_THRESHOLD=0.30
DAILY_QUESTION_LIMIT=10
CACHE_TTL_SECONDS=86400
